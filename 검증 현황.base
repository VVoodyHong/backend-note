filters:
  and:
    - file.inFolder(this.file.folder)
    - file.ext == "md"
    - note.category != null
properties:
  file.name:
    displayName: 노트
  note.category:
    displayName: 분류
  note.updated:
    displayName: 마지막 수정
views:
  - type: table
    name: 전체 노트
    order:
      - file.name
      - category
      - updated
